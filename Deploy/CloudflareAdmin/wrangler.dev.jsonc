{
  "name": "mrfps-admin-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.css", "**/*.browser.js"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "DEVICE_CODES", "class_name": "DeviceCodes" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceCodes"] }],
  "observability": { "enabled": false }
}
